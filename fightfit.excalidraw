    {
      "id": "kcShW25pF_0UiKqhVmlyG",
      "type": "text",
      "x": -2039.6447799795314,
      "y": -1320.3747168287207,
      "width": 1179.1038761965015,
      "height": 175.6451612903226,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
